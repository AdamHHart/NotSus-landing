# Copy this file to .env and fill in your values. Never commit .env.

# Database (PostgreSQL). Get this from your hosting provider (Railway, Render, Heroku, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# Auth (admin login)
JWT_SECRET=

# Server
PORT=3000

# Email verification (Resend) – required for download verification
RESEND_API_KEY=
# Optional: sender address (must be verified in Resend). Default: onboarding@resend.dev
FROM_EMAIL=
# Optional: site URL for verification links. Default: https://www.notsus.net
BASE_URL=

# Podcast (optional overrides)
PODCAST_RSS_URL=https://anchor.fm/s/110e51648/podcast/rss
PODCAST_SPOTIFY_URL=https://open.spotify.com/show/2W1EDfZ6NJ9Su14Pbm0Mjt
# Set when you have your Apple Podcasts show URL
PODCAST_APPLE_URL=
